{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": ["ts-jest", { "tsconfig": "tsconfig.test.json" }]
  },
  "moduleNameMapper": {
    "^@gex/shared$": "<rootDir>/../../../packages/shared/src/index",
    "^@gex/shared/(.*)": "<rootDir>/../../../packages/shared/src/$1",
    "(^.*/[^/]+)\\.js$": "$1"
  }
}
