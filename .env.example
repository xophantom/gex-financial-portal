# Opcional: o docker-compose.yml já tem todos estes valores como default.
# Copie para .env só para sobrescrever algum.

# Banco (a API monta a DATABASE_URL a partir destes)
POSTGRES_DB=gex_finance_test
POSTGRES_USER=gex
POSTGRES_PASSWORD=gex_local_password

REDIS_URL=redis://redis:6379

# Segredos só para ambiente local
JWT_SECRET=challenge_only_change_me
JWT_REFRESH_SECRET=challenge_only_change_me_too

# Data de referência da avaliação e fuso das regras de calendário
APP_TODAY=2026-09-18
APP_TIMEZONE=America/Sao_Paulo

# Portas publicadas no host
POSTGRES_PORT=5432
API_PORT=3001
WEB_PORT=3000
