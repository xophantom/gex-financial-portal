{
  "name": "gex-financial-portal",
  "private": true,
  "packageManager": "pnpm@10.30.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "bootstrap": "pnpm --filter @gex/shared build && pnpm --filter @gex/api exec prisma generate",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "db:migrate": "pnpm --filter @gex/api db:migrate",
    "db:seed": "pnpm --filter @gex/api db:seed",
    "demo:concurrency": "tsx scripts/demo-concurrency.ts"
  },
  "devDependencies": {
    "prettier": "^3.9.9",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "@parcel/watcher",
      "esbuild",
      "msgpackr-extract",
      "unrs-resolver",
      "workerd"
    ]
  }
}
